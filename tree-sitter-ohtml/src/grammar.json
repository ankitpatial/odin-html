{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "ohtml",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "script_element"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        }
      ]
    },
    "script_element": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "script_start_tag"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_script_content"
          },
          "named": true,
          "value": "raw_text"
        },
        {
          "type": "SYMBOL",
          "name": "script_end_tag"
        }
      ]
    },
    "script_start_tag": {
      "type": "STRING",
      "value": "<script lang=\"odin\">"
    },
    "script_end_tag": {
      "type": "STRING",
      "value": "</script>"
    },
    "_node": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "element"
        },
        {
          "type": "SYMBOL",
          "name": "self_closing_element"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "SYMBOL",
          "name": "raw_html_expression"
        },
        {
          "type": "SYMBOL",
          "name": "render_expression"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "element": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "start_tag"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "SYMBOL",
          "name": "end_tag"
        }
      ]
    },
    "self_closing_element": {
      "type": "SYMBOL",
      "name": "self_closing_tag"
    },
    "start_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_or_shorthand"
          }
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "end_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "</"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "self_closing_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_or_shorthand"
          }
        },
        {
          "type": "STRING",
          "value": "/>"
        }
      ]
    },
    "tag_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z][a-zA-Z0-9\\-]*"
    },
    "_attribute_or_shorthand": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute"
        },
        {
          "type": "SYMBOL",
          "name": "attribute_shorthand"
        }
      ]
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "="
                },
                {
                  "type": "SYMBOL",
                  "name": "_attribute_value"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "attribute_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_\\-]*"
    },
    "_attribute_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "quoted_attribute_value"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "quoted_attribute_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "PATTERN",
          "value": "[^\"]*"
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "attribute_shorthand": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "SYMBOL",
          "name": "expression_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "SYMBOL",
          "name": "expression_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "raw_html_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{@html"
        },
        {
          "type": "SYMBOL",
          "name": "expression_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "render_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{@render"
        },
        {
          "type": "SYMBOL",
          "name": "render_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "expression_content": {
      "type": "SYMBOL",
      "name": "_expression_content"
    },
    "render_content": {
      "type": "SYMBOL",
      "name": "_expression_content"
    },
    "text": {
      "type": "SYMBOL",
      "name": "_raw_text"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_script_content"
    },
    {
      "type": "SYMBOL",
      "name": "_expression_content"
    },
    {
      "type": "SYMBOL",
      "name": "_raw_text"
    }
  ],
  "inline": [],
  "supertypes": []
}
