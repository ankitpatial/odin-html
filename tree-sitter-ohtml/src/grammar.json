{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "ohtml",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "script_element"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        }
      ]
    },
    "script_element": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "script_start_tag"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_script_content"
          },
          "named": true,
          "value": "raw_text"
        },
        {
          "type": "SYMBOL",
          "name": "script_end_tag"
        }
      ]
    },
    "script_start_tag": {
      "type": "STRING",
      "value": "<script lang=\"odin\">"
    },
    "script_end_tag": {
      "type": "STRING",
      "value": "</script>"
    },
    "_node": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "element"
        },
        {
          "type": "SYMBOL",
          "name": "self_closing_element"
        },
        {
          "type": "SYMBOL",
          "name": "component"
        },
        {
          "type": "SYMBOL",
          "name": "self_closing_component"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "SYMBOL",
          "name": "raw_html_expression"
        },
        {
          "type": "SYMBOL",
          "name": "render_expression"
        },
        {
          "type": "SYMBOL",
          "name": "if_block"
        },
        {
          "type": "SYMBOL",
          "name": "each_block"
        },
        {
          "type": "SYMBOL",
          "name": "snippet_block"
        },
        {
          "type": "SYMBOL",
          "name": "doctype"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "element": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "start_tag"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "SYMBOL",
          "name": "end_tag"
        }
      ]
    },
    "self_closing_element": {
      "type": "SYMBOL",
      "name": "self_closing_tag"
    },
    "start_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_or_shorthand"
          }
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "end_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "</"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "self_closing_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_or_shorthand"
          }
        },
        {
          "type": "STRING",
          "value": "/>"
        }
      ]
    },
    "tag_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z][a-zA-Z0-9\\-]*"
    },
    "_attribute_or_shorthand": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute"
        },
        {
          "type": "SYMBOL",
          "name": "attribute_shorthand"
        }
      ]
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "="
                },
                {
                  "type": "SYMBOL",
                  "name": "_attribute_value"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "attribute_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_\\-]*"
    },
    "_attribute_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "quoted_attribute_value"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "quoted_attribute_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "PATTERN",
          "value": "[^\"]*"
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "attribute_shorthand": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "SYMBOL",
          "name": "expression_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "SYMBOL",
          "name": "expression_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "raw_html_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{@html"
        },
        {
          "type": "SYMBOL",
          "name": "expression_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "render_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{@render"
        },
        {
          "type": "SYMBOL",
          "name": "render_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "expression_content": {
      "type": "SYMBOL",
      "name": "_expression_content"
    },
    "render_content": {
      "type": "SYMBOL",
      "name": "_expression_content"
    },
    "if_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "if_start"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "else_if_clause"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "else_clause"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "if_end"
        }
      ]
    },
    "if_start": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{#if"
        },
        {
          "type": "SYMBOL",
          "name": "expression_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "else_if_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{:else if"
        },
        {
          "type": "SYMBOL",
          "name": "expression_content"
        },
        {
          "type": "STRING",
          "value": "}"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        }
      ]
    },
    "else_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{:else}"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        }
      ]
    },
    "if_end": {
      "type": "STRING",
      "value": "{/if}"
    },
    "each_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "each_start"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "else_clause"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "each_end"
        }
      ]
    },
    "each_start": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{#each"
        },
        {
          "type": "SYMBOL",
          "name": "expression_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "each_end": {
      "type": "STRING",
      "value": "{/each}"
    },
    "snippet_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "snippet_start"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "SYMBOL",
          "name": "snippet_end"
        }
      ]
    },
    "snippet_start": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{#snippet"
        },
        {
          "type": "SYMBOL",
          "name": "snippet_name"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "snippet_params"
        },
        {
          "type": "STRING",
          "value": ")}"
        }
      ]
    },
    "snippet_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "snippet_params": {
      "type": "PATTERN",
      "value": "[^)]*"
    },
    "snippet_end": {
      "type": "STRING",
      "value": "{/snippet}"
    },
    "component": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "component_start_tag"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "SYMBOL",
          "name": "component_end_tag"
        }
      ]
    },
    "self_closing_component": {
      "type": "SYMBOL",
      "name": "component_self_closing_tag"
    },
    "component_start_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "component_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_or_shorthand"
          }
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "component_end_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "</"
        },
        {
          "type": "SYMBOL",
          "name": "component_name"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "component_self_closing_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "component_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_or_shorthand"
          }
        },
        {
          "type": "STRING",
          "value": "/>"
        }
      ]
    },
    "component_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*\\.[A-Z][a-zA-Z0-9_]*"
    },
    "doctype": {
      "type": "PATTERN",
      "value": "<!DOCTYPE\\s+html\\s*>",
      "flags": "i"
    },
    "comment": {
      "type": "SYMBOL",
      "name": "_comment"
    },
    "text": {
      "type": "SYMBOL",
      "name": "_raw_text"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_script_content"
    },
    {
      "type": "SYMBOL",
      "name": "_expression_content"
    },
    {
      "type": "SYMBOL",
      "name": "_raw_text"
    },
    {
      "type": "SYMBOL",
      "name": "_comment"
    }
  ],
  "inline": [],
  "supertypes": []
}
